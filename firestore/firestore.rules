rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function member(hid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members; }
    function validProfile(uid) {
      return request.resource.data.keys().hasOnly(['displayName', 'householdId'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && request.resource.data.householdId is string
        && (request.resource.data.householdId == '' || uid in getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members);
    }
    function validRecord(isPrivate) {
      return request.resource.data.private == isPrivate
        && request.resource.data.kind in ['task','occurrence','plan','contribution','moment','transaction','health','quest','safetyCheckIn','safetyAlert','smartDevice','careEvent']
        && (isPrivate || request.resource.data.kind != 'health')
        && (!isPrivate || !(request.resource.data.kind in ['safetyCheckIn','safetyAlert','smartDevice']))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    function validSafetyIdentity() {
      let info = request.resource.data;
      return !(info.kind in ['safetyAlert','safetyCheckIn'])
        || (info.ownerUid == request.auth.uid
          && info.ownerName is string && info.ownerName.size() <= 100
          && info.latitude is number && info.latitude >= -90 && info.latitude <= 90
          && info.longitude is number && info.longitude >= -180 && info.longitude <= 180
          && info.mapUrl is string && info.mapUrl.size() <= 256
          && (info.kind != 'safetyAlert' || (info.createdAt is int && info.createdAt > 0))
          && (info.kind != 'safetyCheckIn' || (info.capturedAt is int && info.capturedAt > 0)));
    }
    function validSafetyUpdateOwner() {
      return resource.data.kind != 'safetyCheckIn'
        || (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid);
    }
    function validCareEvent() {
      let event = request.resource.data;
      return event.keys().hasAll(['kind','private','careType','subject','actorUid','actorName','occurredAt','date','updatedBy','updatedAt'])
        && event.keys().hasOnly(['kind','private','careType','subject','actorUid','actorName','occurredAt','date','updatedBy','updatedAt'])
        && event.kind == 'careEvent'
        && event.careType in ['diaper','bottle','bath','petFood']
        && ((event.careType in ['diaper','bottle','bath'] && event.subject == 'Lucca')
          || (event.careType == 'petFood' && event.subject == 'Mel'))
        && event.actorUid == request.auth.uid
        && event.actorName is string && event.actorName.size() <= 100
        && event.occurredAt is int && event.occurredAt > 0
        && event.date is string && event.date.size() == 10;
    }
    function inviteJoin(hid) {
      let inv = get(/databases/$(database)/documents/invites/$(resource.data.inviteId));
      let after = getAfter(/databases/$(database)/documents/invites/$(resource.data.inviteId));
      return resource.data.members.size() == 1 && !(request.auth.uid in resource.data.members)
        && request.auth.token.email_verified == true && inv.data.email == request.auth.token.email
        && inv.data.householdId == hid && inv.data.expiresAt > request.time && inv.data.usedBy == ''
        && after.data.usedBy == request.auth.uid
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }
    match /users/{uid} {
      allow get: if own(uid);
      allow list, delete: if false;
      allow create, update: if own(uid) && validProfile(uid);
      match /records/{rid} {
        allow read: if own(uid);
        allow create: if own(uid) && validRecord(true) && request.resource.data.kind != 'quest' && (request.resource.data.kind != 'careEvent' || validCareEvent());
        allow update: if own(uid) && validRecord(true) && request.resource.data.kind == resource.data.kind && !(resource.data.kind in ['contribution','careEvent']);
        allow delete: if own(uid) && (resource.data.kind in ['task','occurrence','plan','moment','transaction','health'] || (resource.data.kind == 'careEvent' && resource.data.actorUid == request.auth.uid));
      }
    }
    match /households/{hid} {
      allow get: if member(hid);
      allow list, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','creatorUid','members','inviteId','createdAt'])
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.inviteId == '' && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == hid
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == '');
      allow update: if signedIn() && (
        (member(hid) && request.auth.uid == resource.data.creatorUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteId'])
          && resource.data.members.size() == 1
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.householdId == hid
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.ownerUid == request.auth.uid)
        || inviteJoin(hid)
        || (member(hid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == '')
      );
      match /baskets/{market} {
        allow read: if member(hid);
        allow create, update: if member(hid) && market in ['Mercado', 'Açougue']
          && request.resource.data.keys().hasOnly(['market','generation','budget','revision','entries'])
          && request.resource.data.market == market
          && request.resource.data.generation is string && request.resource.data.generation.size() >= 32
          && request.resource.data.budget is int && request.resource.data.budget >= 0 && request.resource.data.budget <= 1000000000
          && request.resource.data.entries is list && request.resource.data.entries.size() <= 200
          && request.resource.data.revision is int
          && ((!exists(/databases/$(database)/documents/households/$(hid)/baskets/$(market)) && request.resource.data.revision == 1)
            || (exists(/databases/$(database)/documents/households/$(hid)/baskets/$(market)) && request.resource.data.revision == resource.data.revision + 1));
        allow delete: if false;
      }
      match /catalogLinks/{skuId} {
        function validCatalogLink() {
          let link = request.resource.data;
          let sku = get(/databases/$(database)/documents/households/$(hid)/records/$(skuId));
          return link.keys().hasOnly(['kind','private','skuId','baseItemId','status','revision','updatedBy','updatedAt'])
            && link.kind == 'catalogLink' && link.private == false
            && link.skuId == skuId && link.baseItemId is string
            && sku.data.kind == 'catalogSku' && sku.data.private == false
            && link.status in ['confirmed','separate']
            && ((link.status == 'separate' && link.baseItemId == '')
              || (link.status == 'confirmed' && link.baseItemId.size() > 0 && link.baseItemId.matches('^[^/]+$')
                && get(/databases/$(database)/documents/households/$(hid)/records/$(link.baseItemId)).data.kind == 'catalogItem'
                && get(/databases/$(database)/documents/households/$(hid)/records/$(link.baseItemId)).data.private == false))
            && link.revision is int && link.revision > 0
            && link.updatedBy == request.auth.uid && link.updatedAt == request.time;
        }
        allow read: if member(hid);
        allow create: if member(hid) && validCatalogLink() && request.resource.data.revision == 1;
        allow update: if member(hid) && validCatalogLink()
          && resource.data.kind == 'catalogLink' && resource.data.skuId == skuId
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }
      match /records/{rid} {
        allow read: if member(hid);
        // Imported catalogue stays immutable, except for user-maintained inventory.
        function validCatalogInventoryUpdate() {
          let next = request.resource.data;
          let changed = next.diff(resource.data).affectedKeys();
          return resource.data.kind == 'catalogItem' && resource.data.private == false
            && next.kind == 'catalogItem' && next.private == false
            && changed.hasOnly(['stockKnown','stockMilli','storageRoom','hasAtHome','updatedBy','updatedAt'])
            && next.stockKnown is bool
            && next.stockMilli is int && next.stockMilli >= 0 && next.stockMilli <= 100000000
            && (next.stockKnown || next.stockMilli == 0)
            && next.storageRoom is string && next.storageRoom.size() <= 60
            && next.hasAtHome is bool
            && next.updatedBy == request.auth.uid && next.updatedAt == request.time;
        }
        function newQuest() {
          return request.resource.data.kind == 'quest'
            && request.resource.data.creatorUid == request.auth.uid
            && request.resource.data.accepted == [request.auth.uid]
            && request.resource.data.completed == [] && request.resource.data.cancelled == false
            && get(/databases/$(database)/documents/households/$(hid)).data.members.size() == 2;
        }
        function questResponse() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return resource.data.kind == 'quest' && resource.data.cancelled == false && (
            (changed.hasOnly(['accepted']) && request.resource.data.accepted == resource.data.accepted.concat([request.auth.uid])
              && !(request.auth.uid in resource.data.accepted) && request.resource.data.accepted.size() == 2)
            || (changed.hasOnly(['completed']) && resource.data.accepted.size() == 2 && request.auth.uid in resource.data.accepted
              && !(request.auth.uid in resource.data.completed)
              && request.resource.data.completed == resource.data.completed.concat([request.auth.uid])
              && request.resource.data.completed.size() <= 2)
            || (changed.hasOnly(['cancelled']) && request.resource.data.cancelled == true && resource.data.completed.size() < 2)
          );
        }
        function receipt() {
          let basket = get(/databases/$(database)/documents/households/$(hid)/baskets/$(request.resource.data.market));
          let next = getAfter(/databases/$(database)/documents/households/$(hid)/baskets/$(request.resource.data.market));
          return request.resource.data.kind == 'receipt' && request.resource.data.private == false
            && rid == basket.data.generation && request.resource.data.generation == rid
            && request.resource.data.entries == basket.data.entries
            && request.resource.data.budget == basket.data.budget && request.resource.data.revision == basket.data.revision
            && request.resource.data.total is int && request.resource.data.total >= 0
            && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
            && next.data.generation != basket.data.generation && next.data.revision == basket.data.revision + 1;
        }
        allow create: if member(hid) && ((validRecord(false) && validSafetyIdentity() && (request.resource.data.kind != 'quest' || newQuest()) && (request.resource.data.kind != 'careEvent' || validCareEvent())) || receipt());
        allow update: if member(hid) && ((validRecord(false) && validSafetyIdentity() && validSafetyUpdateOwner()
          && request.resource.data.kind == resource.data.kind
          && !(resource.data.kind in ['receipt','contribution','quest','safetyAlert','careEvent'])) || questResponse() || validCatalogInventoryUpdate());
        allow delete: if member(hid) && (resource.data.kind in ['task','occurrence','plan','moment','transaction']
          || (resource.data.kind == 'careEvent' && resource.data.actorUid == request.auth.uid)
          || (resource.data.kind == 'safetyCheckIn' && resource.data.ownerUid == request.auth.uid));
      }
    }
    match /invites/{iid} {
      allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid
        || (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email));
      allow list, delete: if false;
      allow create: if signedIn() && member(request.resource.data.householdId)
        && request.resource.data.keys().hasOnly(['householdId','ownerUid','email','expiresAt','usedBy'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.email is string
        && request.resource.data.usedBy == '' && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.inviteId == iid;
      allow update: if signedIn() && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email && resource.data.expiresAt > request.time
        && resource.data.usedBy == '' && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == resource.data.householdId;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
